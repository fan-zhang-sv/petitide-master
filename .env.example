# Firebase configuration. When all required keys are present, the app enables
# Google sign-in and Firestore-backed sync. Leave blank to keep the app
# running in local-only mode (Dexie/IndexedDB).
#
# 1. Create a Firebase project (https://console.firebase.google.com).
# 2. Enable Authentication → Sign-in method → Google.
# 3. Enable Cloud Firestore (production mode is fine — see rules below).
# 4. Copy the web app config values into the variables below.
#
# Suggested Firestore security rules:
#
#   rules_version = '2';
#   service cloud.firestore {
#     match /databases/{database}/documents {
#       match /users/{uid}/{document=**} {
#         allow read, write: if request.auth != null && request.auth.uid == uid;
#       }
#     }
#   }

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: enables Firebase Analytics if set.
VITE_FIREBASE_MEASUREMENT_ID=
